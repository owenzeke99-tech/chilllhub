-- Khai báo Key chính xác và Link Get Key
local correctKey = "ChillHubKeyGsjei - Hshwiwowiwbkeod"
local getKeyLink = "https://link4m.net/4TyRVC6P"

-- Tên file lưu trạng thái key trong thư mục của Executor (Lưu trong 24 giờ)
local saveFileName = "ChillHub_KeyAuth.json"
local isKeyValid = false

-- Kiểm tra xem người dùng đã lưu key và còn hạn trong vòng 24 giờ qua hay không
if pcall(function() return readfile(saveFileName) end) then
    local success, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(readfile(saveFileName))
    end)
    if success and data and data.key == correctKey and (os.time() - data.time) < 86400 then
        isKeyValid = true
    end
end

-- Nếu key còn hạn thì bỏ qua bảng nhập và chạy thẳng script chính
if isKeyValid then
    loadstring(game:HttpGet("https://raw.githubusercontent.com/tienkhanh1/spicy/main/Chilli.lua"))()
    return
end

