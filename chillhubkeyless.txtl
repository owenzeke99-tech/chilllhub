-- Hàm hiệu ứng lắc mượt mà bằng TweenService
local function playSmoothTweenShake()
    TextBox.Text = ""
    
    local originalPos = UDim2.new(0.5, -210, 0.5, -130)
    local tweenInfo = TweenInfo.new(0.06, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    
    local steps = {
        originalPos + UDim2.new(0, 7, 0, 0),
        originalPos + UDim2.new(0, -7, 0, 0),
        originalPos + UDim2.new(0, 4, 0, 0),
        originalPos + UDim2.new(0, -4, 0, 0),
        originalPos + UDim2.new(0, 2, 0, 0),
        originalPos + UDim2.new(0, -2, 0, 0),
        originalPos
    }
    
    for _, targetPos in ipairs(steps) do
        local tween = TweenService:Create(MainFrame, tweenInfo, {Position = targetPos})
        tween:Play()
        tween.Completed:Wait()
    end
    
    MainFrame.Position = originalPos
end

-- Sự kiện bấm nút Get Key (copy link Link4m của bạn)
GetKeyButton.MouseButton1Click:Connect(function()
    setclipboard(getKeyLink)
    StatusLabel.Text = "Copied Get Key link to clipboard!"
    StatusLabel.TextColor3 = Color3.fromRGB(80, 200, 255)
end)

-- Sự kiện bấm nút Check Key
CheckButton.MouseButton1Click:Connect(function()
    if TextBox.Text == correctKey then
        StatusLabel.Text = "Key correct! Loading..."
        StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
        
        -- Lưu key và thời gian hiện tại vào executor để nhớ trong 24 giờ
        pcall(function()
            local dataToSave = game:GetService("HttpService"):JSONEncode({
                key = correctKey,
                time = os.time()
            })
            writefile(saveFileName, dataToSave)
        end)
        
        task.wait(1)
        ScreenGui:Destroy()
        
        -- Chạy script chính
        loadstring(game:HttpGet("https://raw.githubusercontent.com/tienkhanh1/spicy/main/Chilli.lua"))()
    else
        StatusLabel.Text = "Incorrect Key! Please try again."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        
        coroutine.wrap(playSmoothTweenShake)()
    end
end)
